# Template only. Copy outside the skill to ~/.hermes/secrets/meshcore/.env.
# Populate locally. Never share the completed file with any assistant.
RT_BASE=https://remoteterm.example.internal:8081
RT_USER=replace-locally
RT_PASS='replace-locally'
MESHCORE_REPEATER_PASSWORD='replace-locally'
# Omit RT_CA_FILE when the server certificate is trusted by the system trust store.
# RT_CA_FILE=/absolute/path/to/trusted-remoteterm-ca.pem
# Optional full-key restrictions (real 64-character hex public keys only):
# MESHCORE_ALLOWED_KEYS=FULL_KEY_1,FULL_KEY_2
# Optional per-node credentials override the shared password:
# MESHCORE_REPEATER_PASSWORD_A1B2C3='replace-locally'
# Optional local-tunnel HTTP (never use for LAN/tailnet HTTP):
# RT_BASE=http://127.0.0.1:8081
# RT_ALLOW_HTTP_LOOPBACK=1
